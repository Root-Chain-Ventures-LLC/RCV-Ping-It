# PingIt configuration. ./install.sh copies this to .env and fills in the blank
# secrets with strong random values; an existing .env is never overwritten.

# --- Version ---
# The release this bundle installs. Images are pulled at this tag.
# To upgrade: set the new tag here, then `docker compose pull && docker compose up -d`.
PINGIT_VERSION=v1.0.0

# --- Environment (development | production) ---
# production: missing secrets are fatal at startup instead of being generated.
PINGIT_ENVIRONMENT=production

# --- Public ports (host) ---
PINGIT_HTTP_PORT=8080
PINGIT_HTTPS_PORT=8443

# --- Database ---
POSTGRES_USER=pingit
POSTGRES_PASSWORD=changeme-dev-only
POSTGRES_DB=pingit

# --- Cookies / HTTPS ---
# Secure session cookies (browsers drop them on plain HTTP; the bundled Caddy serves HTTPS).
PINGIT_SESSION_COOKIE_SECURE=1
# The bundled Caddy terminates TLS and the worker talks to the collector over the
# private compose network via plain http, so app-layer HTTPS enforcement stays off here.
# Set 1 only when running the app outside this compose file behind your own
# TLS-terminating proxy that sets X-Forwarded-Proto.
PINGIT_REQUIRE_HTTPS=0
# Trusted reverse-proxy hops in front of `web` (X-Forwarded-For / -Proto are only
# honoured through this many hops). The bundled Caddy is exactly one.
PINGIT_TRUSTED_PROXY_COUNT=1

# --- Secrets (generated by install.sh; back them up, see the README) ---
# Fernet key: encrypts secrets stored in the database (SSO client secret, integration credentials).
PINGIT_SECRETS_ENCRYPTION_KEY=
# Ed25519 keypair that signs agent packages. Agents trust this key: never change it on a
# running fleet. Private key as PEM on one line (\n escapes); public key as raw urlsafe base64.
PINGIT_AGENT_SIGNING_PRIVKEY_PEM=
PINGIT_AGENT_SIGNING_PUBKEY_B64=

# --- Sign-in ---
# There is no seeded account: the first browser visit runs a setup page that creates the
# first admin and asks for a one-time setup token (read it with
# `docker compose logs web | grep 'SETUP TOKEN'`). Set this only to choose the token yourself:
# PINGIT_SETUP_TOKEN=
# The public URL users reach PingIt at (used for the SSO redirect URI; the setup wizard
# can also set it):
# PINGIT_PUBLIC_BASE_URL=https://pingit.example.com
# SSO (any OpenID Connect provider) is configured afterwards in Settings -> SSO.
# Allow an http:// OIDC issuer (plain-HTTP LAN only):
# PINGIT_OIDC_ALLOW_INSECURE_ISSUER=true
# Break-glass: accept password login even though Settings -> SSO switched it off
# (remove once the identity provider is fixed):
# PINGIT_ALLOW_LOCAL_LOGIN_OVERRIDE=1

# --- Syslog forwarding (optional) ---
# PINGIT_SYSLOG_ENABLED=false
# PINGIT_SYSLOG_HOST=logs.example.com
# PINGIT_SYSLOG_PORT=514
# PINGIT_SYSLOG_PROTOCOL=udp
# PINGIT_SYSLOG_FACILITY=local0
# Elasticsearch export, alert delivery (webhook / e-mail) and branding are set in the
# admin UI (Settings), not here.

# --- Sub-path install (optional) ---
# Only when PingIt is served under a path prefix by a proxy that strips the prefix
# (e.g. /pingit). Leave unset to serve at the root of the host.
# PINGIT_ROOT_PATH=/pingit
